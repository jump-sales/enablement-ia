# ==== Banco de dados ====
# Papel dono do schema (migrations). NUNCA usado pela aplicação em runtime.
DATABASE_OWNER_URL=postgres://jump_owner:CHANGE_ME@localhost:5432/jump
# Papel de runtime da aplicação e do worker (sujeito a Row-Level Security).
DATABASE_URL=postgres://jump_app:CHANGE_ME@localhost:5432/jump

# ==== Autenticação ====
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ==== Storage de mídia ====
# local | s3   (s3 = qualquer compatível: Cloudflare R2, MinIO, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Validade das URLs temporárias de mídia (segundos)
MEDIA_URL_TTL_SECONDS=300

# ==== Provedores de IA (deixe vazio para usar o provedor simulado) ====
# mock | assemblyai | deepgram
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_API_KEY=
# mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_EVALUATION=claude-opus-5-5
LLM_MODEL_LIGHT=claude-haiku-5-5

LOG_LEVEL=info

# ==== Google Drive (importação de transcrições — opcional) ====
# Valores públicos do projeto Google Cloud da Jump (ver docs/INTEGRACAO_GOOGLE_DRIVE.md).
# Restrinja a chave de API ao Google Picker e ao domínio da aplicação.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
